{
  "name": "dsh-chart",
  "version": "1.1.0",
  "description": "图表插件：把回复里的 mermaid 代码块（柱状图 / 折线图 / 饼图 / 流程图）直接渲染成卡片，卡片右上角可一键在「图表」和「表格」之间切换。mermaid 11.16 已内联，离线可用，不依赖任何外部资源。",
  "icon": "assets/icon.svg",
  "type": "module",
  "main": "./index.js",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "chart",
    "mermaid",
    "web-ui"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./assets/*": "./assets/*",
    "./locale/*": "./locale/*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "client.js",
    "index.js",
    "cordis.patch.yml",
    "assets",
    "locale",
    "README.md",
    "LICENSE",
    "src",
    "scripts"
  ],
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chen9183/dsh-chart.git"
  },
  "homepage": "https://github.com/Chen9183/dsh-chart#readme",
  "bugs": {
    "url": "https://github.com/Chen9183/dsh-chart/issues"
  }
}